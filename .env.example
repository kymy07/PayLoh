# Copy this file to .env.local and fill in the values from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
#
# .env.local is gitignored and must stay that way — it is the only file in this
# repo that holds your project's keys.

VITE_FIREBASE_API_KEY=PASTE_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=payloh-website.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://payloh-website-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=payloh-website
VITE_FIREBASE_STORAGE_BUCKET=payloh-website.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=PASTE_YOUR_APP_ID
